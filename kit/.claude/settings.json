{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Permission rules here are GUARDRAILS, not a security boundary: prefix patterns like Bash(rm *) are bypassable (/bin/rm, sh -c, git -C). They prevent the expensive accident (eager commits, stray curl), nothing more. Real boundaries need OS/container sandboxing. Model tiering lives in env below + agent frontmatter + CLAUDE.md — see README 'When models change'.",
  "permissions": {
    "allow": [
      "Read(./**)",
      "Grep(**)",
      "Glob(**)",
      "Bash(pytest tests/ -q*)",
      "Bash(ruff check .*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(openspec list*)",
      "Bash(openspec status*)",
      "Bash(openspec instructions*)",
      "Bash(openspec validate*)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(openspec archive*)",
      "Read(./.env*)",
      "Read(./secrets/**)"
    ]
  },
  "env": {
    "ANTHROPIC_SMALL_FAST_MODEL": "claude-haiku-4-5"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block_bulk_read.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/token_audit.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session_end.sh"
          }
        ]
      }
    ]
  }
}
